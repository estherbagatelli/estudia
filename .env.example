# ---------------------------------------------------------------------------
# Supabase — client (browser) credentials.
# Copy this file to `.env` and fill with your project's values.
#   Supabase Dashboard > Project Settings > API
# Only the ANON (public) key goes here. NEVER put the service_role key in a
# VITE_* variable — it would be shipped to the browser.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---------------------------------------------------------------------------
# Google OAuth (ONLY needed for the LOCAL Supabase stack, `supabase start`).
# The hosted project reads these from the Dashboard instead
# (Authentication > Providers > Google), so leave them empty for cloud-only use.
# ---------------------------------------------------------------------------
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
